# Copy to backend/.env and fill in. Never commit the real file.
PORT=8787
# API logging: debug | info | warn | error
# LOG_LEVEL=info
# Local API URL (OAuth callbacks and Stripe webhooks).
PUBLIC_URL=http://localhost:8787
# Local website URL. Users are redirected here after login, checkout, etc.
WEB_URL=http://localhost:5173
# Shares the session cookie between the website and the API (empty in local dev).
COOKIE_DOMAIN=
# Domain Caddy requests an HTTPS certificate for in production.
API_DOMAIN=localhost
# Local Postgres for native development; the local Docker Compose stack overrides this.
DATABASE_URL=postgres://interviewveil:localdev@localhost:5433/interviewveil

# AI + transcription keys (the desktop app never sees these)
ANTHROPIC_API_KEY=
# Required when ANTHROPIC_API_KEY is an unscoped user key (sk-ant-usr-…).
# Console → Settings → Workspaces (wrkspc_…). Workspace-scoped keys can omit this.
ANTHROPIC_WORKSPACE_ID=
STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=gpt-4o-mini-transcribe

# Model per tier. Free/Essential → haiku, Professional → sonnet, Expert → opus.
MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_OPUS=claude-opus-5-5

# Sign-in providers (OAuth apps). Callback URLs (on the API domain):
#   https://api.interviewveil.app/auth/google/callback
#   https://api.interviewveil.app/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password-reset emails via https://brevo.com (required when NODE_ENV=production)
BREVO_API_KEY=
EMAIL_FROM=InterviewVeil <hello@yourdomain.com>
# Support chat: who can answer (comma-separated; the email must be verified via
# Google/GitHub sign-in or a password reset), and the hours shown in the widget.
ADMIN_EMAILS=you@yourdomain.com
SUPPORT_HOURS=Mon-Fri 09:00-18:00
SUPPORT_TIMEZONE=Africa/Nairobi

# Stripe (test-mode keys while developing). Products/prices: `npm run stripe:setup`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Question difficulty for practice: easy | medium | hard
PRACTICE_DIFFICULTY=medium
RATE_LIMIT_PER_MINUTE=20
