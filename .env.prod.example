# Production template — copy to .env.prod, fill secrets, then deploy to server as .env
# See backend-deployment-plan.md and deploy/native/README.md

NODE_ENV=production
PORT=8787
LOG_LEVEL=info
LOG_FORMAT=json

PUBLIC_URL=https://api.interviewveil.com
WEB_URL=https://interviewveil.com
# Optional comma-separated extra marketing origins (API also trusts www when WEB_URL is apex).
# WEB_ORIGINS=
COOKIE_DOMAIN=.interviewveil.com
API_DOMAIN=api.interviewveil.com

DATABASE_URL=postgres://interviewveil_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/Interviewveil_db

# Production: Anthropic for chat, OpenAI for transcription (STT_* below).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe

MODEL_HAIKU=claude-haiku-4-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_OPUS=claude-opus-5-5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BREVO_API_KEY=
EMAIL_FROM=InterviewVeil <hello@interviewveil.com>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PRACTICE_DIFFICULTY=medium
RATE_LIMIT_PER_MINUTE=20

ADMIN_EMAILS=hello@interviewveil.com
SUPPORT_HOURS=Mon-Fri 09:00-18:00
SUPPORT_TIMEZONE=Africa/Nairobi
